<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.InventoryManager" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/colorPrimaryVariant</item>
    </style>

    <!-- Splash screen theme — hides action bar / status bar -->
    <style name="Theme.InventoryManager.Splash" parent="Theme.InventoryManager">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
    </style>

    <!-- Toolbar style -->
    <style name="Widget.InventoryManager.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/colorOnPrimary</item>
    </style>

    <!-- FAB style -->
    <style name="Widget.InventoryManager.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/colorSecondary</item>
        <item name="tint">@color/colorOnPrimary</item>
    </style>

    <!-- Card style -->
    <style name="Widget.InventoryManager.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/colorCardBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Input field style -->
    <style name="Widget.InventoryManager.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimaryLight</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
    </style>

    <!-- Primary button -->
    <style name="Widget.InventoryManager.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Danger button (delete) -->
    <style name="Widget.InventoryManager.Button.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorOutOfStock</item>
        <item name="android:textColor">@color/colorOutOfStock</item>
        <item name="rippleColor">@color/colorOutOfStockBg</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

</resources>